<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="#F4F0EA">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_marginRight="@dimen/hy_lay_dp_20"
        android:layout_marginTop="@dimen/hy_lay_dp_30"
        android:layout_width="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/hy_lay_dp_8"
        android:paddingEnd="@dimen/hy_lay_dp_8">

        <TextView
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/hy_lay_dp_5"
            android:text="@string/app_version_title"
            android:textColor="#000"
            android:textSize="@dimen/hy_font_sp_18"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title_tv" />

        <TextView
            android:id="@+id/tv_app_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/hy_lay_dp_3"
            android:text="8.3"
            android:textColor="#000"
            android:textSize="@dimen/hy_font_sp_18"
            app:layout_constraintBaseline_toBaselineOf="@+id/textView"
            app:layout_constraintStart_toEndOf="@+id/textView" />

        <TextView
            android:id="@+id/textView1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/main_control_version"
            android:textColor="#000"
            android:textSize="@dimen/hy_font_sp_18"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView" />

        <TextView
            android:id="@+id/tv_control_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/hy_lay_dp_3"
            android:text="4.0"
            android:textColor="#000"
            android:textSize="@dimen/hy_font_sp_18"
            app:layout_constraintBaseline_toBaselineOf="@+id/textView1"
            app:layout_constraintStart_toEndOf="@+id/textView1" />

        <TextView
            android:id="@+id/tv_version_update"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:theme="@style/baseTextTheme1"
            android:visibility="invisible"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_control_version" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:layout_marginTop="@dimen/hy_lay_dp_150"
        android:id="@+id/ll_auto"
        android:layout_marginRight="@dimen/hy_lay_dp_176"
        android:layout_marginLeft="@dimen/hy_lay_dp_232"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:id="@+id/tv_caring_mode"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center"
                android:src="@drawable/caring_mode"
                android:layout_width="@dimen/hy_lay_dp_74"
                android:layout_height="@dimen/hy_lay_dp_71"/>
            <TextView
                android:layout_marginTop="@dimen/hy_lay_dp_13"
                android:drawablePadding="@dimen/hy_lay_dp_13"
                android:text="关怀模式"
                android:gravity="center_horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <LinearLayout
            android:visibility="gone"
            android:orientation="vertical"
            android:id="@+id/tv_classic_mode"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent">
            <ImageView
                android:layout_gravity="center"
                android:src="@drawable/dark_mode"
                android:layout_width="@dimen/hy_lay_dp_74"
                android:layout_height="@dimen/hy_lay_dp_71"/>

            <TextView
                android:layout_marginTop="@dimen/hy_lay_dp_13"
                android:text="经典模式"
                android:gravity="center_horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>



        <LinearLayout
            android:visibility="gone"
            android:orientation="vertical"
            android:id="@+id/tv_dark_mode"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent">
            <ImageView
                android:layout_gravity="center"
                android:src="@drawable/dark_mode"
                android:layout_width="@dimen/hy_lay_dp_74"
                android:layout_height="@dimen/hy_lay_dp_71"/>

            <TextView
                android:layout_marginTop="@dimen/hy_lay_dp_13"
                android:text="深色模式"
                android:gravity="center_horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>


        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/tv_wifi"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent">
            <ImageView
                android:layout_gravity="center"
                android:src="@drawable/wifi"
                android:layout_width="@dimen/hy_lay_dp_74"
                android:layout_height="@dimen/hy_lay_dp_71"/>

            <TextView
                android:layout_marginTop="@dimen/hy_lay_dp_13"
                android:text="配网功能"
                android:gravity="center_horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <LinearLayout
            android:visibility="gone"
            android:orientation="vertical"
            android:id="@+id/tv_admin"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent">
            <ImageView
                android:layout_gravity="center"
                android:src="@drawable/admin"
                android:layout_width="@dimen/hy_lay_dp_74"
                android:layout_height="@dimen/hy_lay_dp_71"/>

            <TextView
                android:layout_marginTop="@dimen/hy_lay_dp_13"
                android:text="管理员模式"
                android:gravity="center_horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>



    <LinearLayout
        android:layout_below="@+id/ll_auto"
        android:layout_marginRight="@dimen/hy_lay_dp_176"
        android:layout_marginLeft="@dimen/hy_lay_dp_232"
        android:layout_marginTop="@dimen/hy_lay_dp_154"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:src="@drawable/icon_brightness"
            android:layout_width="@dimen/hy_lay_dp_38"
            android:layout_height="@dimen/hy_lay_dp_38"/>
        <TextView
            android:layout_marginLeft="@dimen/hy_lay_dp_26"
            android:layout_gravity="center_vertical"
            android:text="亮度"
            android:textSize="@dimen/hy_font_sp_18"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <SeekBar
            android:progressBackgroundTint="#D8D8D8"
            android:thumbTint="#AE8567"
            android:progressTint="#AE8567"
            android:layout_marginLeft="@dimen/hy_lay_dp_60"
            android:layout_gravity="center_vertical"
            android:max="100"
            android:min="0"
            android:id="@+id/seekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>


    <LinearLayout
        android:padding="@dimen/hy_lay_dp_10"
        android:layout_alignParentBottom="true"
        android:id="@+id/ll_pop"
        android:layout_gravity="center"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:layout_gravity="bottom"
            android:layout_width="@dimen/hy_lay_dp_166"
            android:layout_height="@dimen/hy_lay_dp_5"
            android:background="#AE8567" />
    </LinearLayout>


</RelativeLayout>
