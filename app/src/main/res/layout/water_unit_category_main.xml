<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/water_category_tabs"
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:background="#EEE4D9"
        app:tabGravity="fill"
        app:tabIndicatorColor="#8B6D55"
        app:tabIndicatorHeight="4dp"
        app:tabMode="fixed"
        app:tabSelectedTextColor="#6E5540"
        app:tabTextColor="#8A786B"
        app:tabTextAppearance="@style/WaterUnitSecondaryTabText" />

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/water_category_viewpager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
